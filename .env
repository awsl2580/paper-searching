# ══════════════════════════════════════════════════════════════════
# 团队共用配置（进版本库）
#
# 这里**不放 API Key**：Key 是个人凭据，由每个使用者写到同目录的
# .env.local 里（该文件在 .gitignore 中，不会被提交）：
#
#     .env.local
#     DEEPSEEK_API_KEY=sk-你的密钥
#
# 加载顺序：.env → .env.local（后者覆盖前者）。系统环境变量优先级最高。
# 全部可配置项及含义见 .env.example。
# ══════════════════════════════════════════════════════════════════

# DeepSeek API Key：留空。启动时会检查，缺了会提示你把 key 写进 .env.local。
# 不要在这里填真实密钥 —— 本文件是提交进仓库的。
DEEPSEEK_API_KEY=

# 对话模型。该 key 实际可用的正式模型只有两个：
#   deepseek-flash      DeepSeek-V4.1-Flash（当前使用）
#   deepseek-v4-pro     DeepSeek-V4-Pro-0813
# 注意 deepseek-flash **默认开思考**：先产出一大段 reasoning_content，
# 之后才开始吐正文。实测一个需要推理的问题：首字 21.4s、总 27.4s
# （对比旧别名 deepseek-chat 的首字 0.6s、总 11.3s）。
# 代码里已把"思考中"的状态推给前端，所以界面上不会像卡住。
# 想换回快而不思考的档位，把下面一行改成 deepseek-chat 即可。
DEEPSEEK_MODEL=deepseek-flash

# 如果国内访问国外API不稳定，可配置代理（按需取消注释）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# API超时秒数（默认30秒）
API_TIMEOUT=30

# 会话签名密钥：登录态就是用它签名的 cookie，泄露等于任何人可伪造登录。
#
# 这一项**留在共用配置里**（不像 API Key 那样留给个人）：
#   * 它不是计费凭据，泄露的后果是"能伪造登录"，而非"被刷钱"
#   * 团队共用同一个值，登录态才能在各自的环境间一致，也不会因为
#     谁重新生成一次就把所有人的登录态一起作废
# 如果部署到公网，建议改成你自己的随机值（改完所有人需重新登录）：
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=1ac899ce1deeb2f8fb979e644f1aeef435939455fac8e15b7987dab8b6fce82
