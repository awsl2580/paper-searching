# DeepSeek API Key（在此填入你的密钥）
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥

# ── Semantic Scholar（论文检索接口）─────────────────────────
# 强烈建议配置。不配也能用，但请求会走"所有人共用的公共通道"，
# 高峰期 /paper/search 会持续返回 429/5xx，表现为"检索服务暂时不可用"。
# 配上之后是你自己的独立配额（默认 1 请求/秒），稳定得多。
# 申请地址：https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# 两次请求之间的最小间隔秒数（默认 1.2，比限额略宽一点更安全）
S2_MIN_INTERVAL=1.2
# 单次请求最多尝试次数（默认 4）
S2_MAX_RETRIES=4
# 退避等待上限秒数（默认 20）
S2_BACKOFF_CAP=20
# 检索结果缓存时间秒数（默认 1800，相同检索不再重复打接口）
S2_CACHE_TTL=1800
# 被限流时是否改用 /paper/search/bulk 兜底（1=开启，0=关闭）
S2_BULK_FALLBACK=1

# 如果国内访问国外 API 不稳定，可配置代理（按需取消注释）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# API 超时秒数（默认30秒）
API_TIMEOUT=30
