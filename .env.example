# ── DeepSeek（必填）────────────────────────────────────────
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥

# 对话模型。留空/删除即用默认值 deepseek-chat。
#
# 注意 "deepseek-chat" 是稳定别名、不是某一代固定模型：实测（2026-09）
# 它由 DeepSeek-V4.1-Flash 承接（/models 只返回 deepseek-flash 与
# deepseek-v4-pro 两个正式名），且走**非思考模式**。
#
# 一般情况下不用改。想换只改这一行：
#   deepseek-chat       默认，V4.1-Flash 非思考模式，快且省
#   deepseek-v4-pro     能力更强，贵约 3~5 倍，不支持 vision
#   deepseek-flash      正式名，但**默认开思考**：本项目的流式代码只读
#                       content、不处理 reasoning_content，思考期间前端
#                       收不到任何内容，观感上会像卡住；推理 token 还按
#                       输出计费。要用它建议同时处理推理内容。
#   deepseek-reasoner   旧 R1 别名，实测已由 V4.1-Flash 承接且支持工具调用
DEEPSEEK_MODEL=deepseek-chat

# ── 文献数据源说明 ────────────────────────────────────────
# 项目自带两个数据源，都不需要额外付费：
#
#   Semantic Scholar   英文为主，免费。不配 key 也能用，但走的是所有人共用的
#                      公共通道，高峰期 /paper/search 会持续返回 429/5xx。
#                      配 key 后是自己的独立配额（默认 1 请求/秒），稳定得多。
#                      申请：https://www.semanticscholar.org/product/api#api-key-form
#
#   OpenAlex           英文+中文，完全免费、无需 key，默认启用。
#                      中文靠 filter=language:zh 过滤，是本项目当前唯一的中文来源。
#                      中文核心期刊覆盖率不如知网/万方，不少中文文献没有摘要或 DOI。
#                      需要更强的中文覆盖，得接入有授权的中文源（知网不开放个人 API，
#                      万方开放平台需要商务申请 appKey），代码里预留了接入位置。

# ── Semantic Scholar ─────────────────────────────────────
# 强烈建议配置。不配也能用，但公共通道高峰期基本不可用。
SEMANTIC_SCHOLAR_API_KEY=

# 两次请求之间的最小间隔秒数（默认 1.2，比限额略宽一点更安全）
S2_MIN_INTERVAL=1.2
# 单次请求最多尝试次数（默认 4）
S2_MAX_RETRIES=4
# 退避等待上限秒数（默认 20）
S2_BACKOFF_CAP=20
# 检索结果缓存时间秒数（默认 1800，相同检索不再重复打接口）
S2_CACHE_TTL=1800
# 被限流时是否改用 /paper/search/bulk 兜底（1=开启，0=关闭）
S2_BULK_FALLBACK=1

# ── OpenAlex ─────────────────────────────────────────────
# 选填邮箱。带上会进入"礼貌池"，服务更稳定（只作为联系标识，不会公开展示）
OPENALEX_MAILTO=
# 两次请求最小间隔秒数（默认 0.2，OpenAlex 宽松，不用压太狠）
OPENALEX_MIN_INTERVAL=0.2
# 检索结果缓存秒数（默认 1800）
OPENALEX_CACHE_TTL=1800

# ── 网络 ─────────────────────────────────────────────────
# 如果国内访问国外 API 不稳定，可配置代理（按需取消注释）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# API 超时秒数（默认 30 秒）
API_TIMEOUT=30

# Flask session 密钥。生产/公网部署一定要改成随机值，否则登录态可被伪造
# FLASK_SECRET_KEY=请改成一段随机字符串
