## ══════════════════════════════════════════════════════════════════
##  DeepSeek 大模型（必填）
## ══════════════════════════════════════════════════════════════════
#
# API Key 申请：https://platform.deepseek.com/api_keys
# 接口文档：https://api-docs.deepseek.com/
#
# 复制本文件为 .env 后填入下面这一行即可启动：
DEEPSEEK_API_KEY=

# 接口地址（OpenAI 兼容）。只写域名也行，程序会自动补 /v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── 模型：只用两个（界面下拉也只能选这两个）─────────────────────
#
#   deepseek-V4.1-flash  快速通用模型：对话、工具调用、批量抽取、读图
#   deepseek-v4-pro      深度推理模型：假设生成、复现校验、独立审稿
#
# 按用途分层：
#   chat    对话主模型   deepseek-V4.1-flash
#   fast    轻量批处理   deepseek-V4.1-flash
#   vision  多模态读图   deepseek-V4.1-flash
#   reason  深度推理     deepseek-v4-pro
#
# 代码里不写死模型名，想调整就改下面四行。界面下拉列表固定为上面两个模型，
# 服务端还会做白名单校验：传别的名字一律回落到默认模型。
DEEPSEEK_MODEL=deepseek-V4.1-flash
DEEPSEEK_FAST_MODEL=deepseek-V4.1-flash
DEEPSEEK_VISION_MODEL=deepseek-V4.1-flash
DEEPSEEK_REASON_MODEL=deepseek-v4-pro

# ── 深度思考 ─────────────────────────────────────────────────
#
# DeepSeek 没有 thinking_mode 字段：打开界面开关 = 本轮改用 deepseek-v4-pro。
# pro 会先输出 reasoning_content（思考），再输出正文；flash 直接回答。
#
# 取值：
#   auto   （默认）只有 reason 用途 / pro 模型算"开"
#   reason 只给"深度推理"用途开（想演示模型的思考过程时用）
#   1      全开（一律用 pro，注意时延与 JSON 截断风险）
#   0      全关（按当前选的模型跑）
DEEPSEEK_THINKING_MODE=auto

# 界面上开了「深度思考」时的 max_tokens（默认 4096）。
# 推理内容占用同一个额度，给少了会出现"HTTP 200 但正文为空"。
# 注意：界面开关（thinking:true）会覆盖上面的 DEEPSEEK_THINKING_MODE。
DEEPSEEK_THINKING_MAX_TOKENS=4096

# JSON 任务重试时的额度下限与策略：
# 第一次失败后，程序会**自动换 flash + 抬高到 DEEPSEEK_JSON_RETRY_TOKENS** 再试一次
# （pro 在"大输入 + 严格 JSON"场景里容易被推理内容截断，换 flash 通常能直接拿到干净 JSON）。
DEEPSEEK_JSON_RETRY_TOKENS=2600

# ── 限流与超时 ───────────────────────────────────────────────
# DeepSeek 按账号动态限流，没有公开固定 RPM。这里默认 60 次/分钟保守起步。
# 本项目一次科研工作流要调 8-12 次模型，多智能体还会并发，
# 所以内置了进程级令牌桶，按最小间隔匀速放行（不会踩线）。
DEEPSEEK_RPM=60
# 单次请求超时秒数（推理模型首字可能要十几秒，别设太小）
DEEPSEEK_TIMEOUT=120
# 失败重试次数（429/5xx 会指数退避）
DEEPSEEK_MAX_RETRIES=4
# 单次请求 max_tokens 缺省值（上限 8192）
DEEPSEEK_MAX_TOKENS=2048

## ══════════════════════════════════════════════════════════════════
##  AI4S 闭环
## ══════════════════════════════════════════════════════════════════
# 「假设—实验—验证—迭代」最多再迭代几轮（0 = 一轮定稿，不做返工）
# 实测（DeepSeek 双模型、真实数据源）：单轮约 120-180s；多跑一轮返工约 +150s。
# 定 1 的理由：两轮都不收敛的题，第三轮基本也不会收敛 —— 不如如实报"未收敛"。
AI4S_MAX_ITERATIONS=1

# 审稿人判 reject（核心结论在现有证据下不成立）时要不要也返工？
# 默认 0：reject 往往意味着"这个假设本身不成立"，用同一份证据重跑一遍不会变；
# 想让系统连负结果都继续追（比如已经判定假设错了就换一条），设 1。
AI4S_ITERATE_ON_REJECT=0

# 每一步"喂给模型"的文献条数上限（按相关度/影响力取前 N）。
# 实测：53 篇全喂 vs 喂 20 篇，单次模型调用 60-90s vs 20-30s，结论几乎不变
# （长尾文献边际信息量低，综述引用本来就集中在前面的文献）。
AI4S_BRIEF_PAPERS=20

## ══════════════════════════════════════════════════════════════════
##  MCP（Model Context Protocol）
## ══════════════════════════════════════════════════════════════════
# 传输方式：
#   inproc  同进程调 mcp_server.handle_request（默认，零开销，便于测试）
#   stdio   真的起一个 `python mcp/mcp_server.py` 子进程（外部 harness 走的就是这条）
#   auto    先试 stdio，握手失败自动退回 inproc，并把原因记在 /api/ai4s/tools
MCP_TRANSPORT=inproc
# 单次工具调用超时秒数
MCP_TIMEOUT=60
#
# 外部 harness（Claude Code / openclaw / hermes 等）挂载方式：
#   command: python
#   args:    ["mcp/mcp_server.py"]
# 也可以先手动看一眼工具目录：python mcp/mcp_server.py --list

## ══════════════════════════════════════════════════════════════════
##  文献数据源（全部免费，无需付费授权）
## ══════════════════════════════════════════════════════════════════
#
#   Semantic Scholar   英文为主，免费。不配 key 也能用，但走公共通道，
#                      高峰期会持续 429。配 key 后是独立配额，稳定得多。
#                      申请：https://www.semanticscholar.org/product/api#api-key-form
#   OpenAlex           英+中，完全免费、无需 key，本项目主要的中文来源
#                      （中文靠 filter=language:zh）。中文核心期刊覆盖率不如知网/万方。
#   Crossref           正式出版物元数据权威源，**卷期页码最全**，
#                      GB/T 7714 的"年, 卷(期): 起止页"主要靠它补全。
#                      必须带 mailto 才会进"礼貌池"（并发 3，而不是并发 1）。
#   Europe PMC         生命科学/生物医学，一次请求拿全（摘要+作者+被引+卷期页）。
#   DOAJ               只收开放获取期刊，用来判断"能不能免费读全文"。
#
# 中文覆盖（如实说明）：真正的中文核心期刊覆盖仍不如知网/万方。
# 知网不开放个人 API；万方有开放平台但需商务授权。
# 新增源的接入位置：providers/__init__.py 的 SOURCES + GROUPS 各加一行。

SEMANTIC_SCHOLAR_API_KEY=
S2_MIN_INTERVAL=1.2
S2_MAX_RETRIES=4
S2_BACKOFF_CAP=20
S2_CACHE_TTL=1800
S2_BULK_FALLBACK=1

OPENALEX_MAILTO=
OPENALEX_MIN_INTERVAL=0.2
OPENALEX_CACHE_TTL=1800

# **强烈建议填写**：Crossref 配额按池划分，公开池并发只有 1，并发检索很容易 429
CROSSREF_MAILTO=
CROSSREF_MIN_INTERVAL=0.34
CROSSREF_CACHE_TTL=1800

EUROPEPMC_MIN_INTERVAL=0.4
EUROPEPMC_CACHE_TTL=1800

DOAJ_MIN_INTERVAL=0.5
DOAJ_CACHE_TTL=1800

## ══════════════════════════════════════════════════════════════════
##  网络
## ══════════════════════════════════════════════════════════════════
# 国内访问国外数据源不稳定时可配代理（按需取消注释）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
API_TIMEOUT=30

# 聊天流的心跳间隔（秒，最小 1 秒，默认 10）。
#
# 聊天接口是 SSE 长连接，服务端在"没有内容可发"的间隙会写一行 `: ping` 注释，
# 证明连接还活着。它是前端"静默看门狗"的依据：
# 连续 45 秒一个字节都收不到，前端就主动结束这一轮等待，而不是把按钮永远
# 停在「思考中...」（连接被代理/内核一直挂着时，以前就会无限等下去）。
# 部署在会掐长连接的网关后面时，可以调小一点（比如 5）。
CHAT_HEARTBEAT_SECONDS=10

## ══════════════════════════════════════════════════════════════════
##  账号与登录态
## ══════════════════════════════════════════════════════════════════
#
# 账号保存在项目目录的 literature.db 里（密码只存 bcrypt 哈希，不可逆），
# 所以注册一次之后，**重启服务仍然能直接登录**，不需要重新注册。
# 注意：literature.db 不要删（删了就等于清空账号与收藏），也不要提交到 git。
#
# 登录态能保持多久（天）。勾选「记住我」后 cookie 会带 Expires，
# 关掉浏览器、重启服务再打开页面仍然是登录状态。设 0 = 只在本次浏览器会话内有效。
LOGIN_DAYS=30

# 账号文件位置（默认项目根目录的 accounts.json）。
# 账号（昵称 / 密码 bcrypt 哈希 / 头像）存在这个 JSON 文件里，不在数据库里 ——
# 好处是能直接打开看、备份只拷一个文件。一般不用改这个变量。
# ACCOUNTS_FILE=accounts.json

# 登录页要不要列出"本机已注册的账号"（点一下就填用户名）。
# 默认只在**本机回环请求**下返回；公网部署保持默认即可，不会把用户名列给路人看。
#   ACCOUNT_HINT=1 强制开启 / =0 强制关闭 / 留空=只有 127.0.0.1 才返回
# ACCOUNT_HINT=

# 开发便利：本机演示时免登录。设成已注册的用户名后，本机未登录请求会自动以该账号登录
# （只对回环地址生效；公网部署**不要**设）。留空 = 正常登录流程。
# DEV_AUTO_LOGIN=

## ══════════════════════════════════════════════════════════════════
##  会话密钥（必填，缺了会拒绝启动）
## ══════════════════════════════════════════════════════════════════
# Flask 的登录态是它签名的一枚 cookie。密钥一旦可猜，
# 任何人都能自己签一个"我是 1 号用户"的 cookie 冒充登录。
# 生成方式（在项目根目录执行，把输出的那行贴进来）：
#   python -c "import secrets; print('FLASK_SECRET_KEY=' + secrets.token_hex(32))"
FLASK_SECRET_KEY=

## ══════════════════════════════════════════════════════════════════
##  公网部署
## ══════════════════════════════════════════════════════════════════
# 监听地址与端口。默认只监听本机 127.0.0.1:8000。
# 内网穿透工具（natapp/ngrok）转发的是隧道里配置的本地端口，要与之对齐：
# APP_HOST=127.0.0.1
# APP_PORT=8000

# 公网访问口令（可选）。留空=完全开放。
# 建议公网部署时设置：本站暴露的是**共享的大模型额度**。
# PUBLIC_PASSWORD=
