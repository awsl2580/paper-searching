# ══════════════════════════════════════════════════════════════════
# 环境变量模板 / 配置说明
#
# 两层的分工（加载顺序 .env → .env.local，后者覆盖前者）：
#
#   .env        进版本库，团队共用：模型名、超时、会话密钥等
#               **不含任何 API Key**
#   .env.local  不进版本库，每人自己写：你的 DEEPSEEK_API_KEY，
#               以及你想临时改的任何项
#
# 也就是说，除了 API Key，其它配置**不用你操心**（.env 里已有）。
# 你只需要在项目根目录建 .env.local，写一行：
#
#     DEEPSEEK_API_KEY=sk-你的密钥
#
# 密钥申请：https://platform.deepseek.com/api_keys
#
# 这个模板的作用是"文档"：列出全部可配置项及其含义，供查阅。
#
# 提示：`.env` 里的 DEEPSEEK_API_KEY 必须是空的。若曾把真实 Key
# 提交进去，需立即到控制台轮换 —— 仅删文件无效，它会留在 git 历史里。
# ══════════════════════════════════════════════════════════════════

# ── DeepSeek（必填，写进 .env.local）──────────────────────
# 这一项不要填在 .env 里（那是进仓库的文件）。
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥

# 对话模型（app.py 的对话与 workflow.py 的工作流共用这一个变量）。
#
# 实测该 key 的 /models 只返回两个正式模型：
#   deepseek-flash      DeepSeek-V4.1-Flash（本项目当前使用）
#   deepseek-v4-pro     DeepSeek-V4-Pro-0813
# 旧名 deepseek-chat / deepseek-reasoner 仍被接受，实际由 V4.1-Flash 承接。
#
# 选型对比（同一个需要推理的问题实测）：
#   deepseek-flash   首字 21.4s / 总 27.4s，产生 4637 字思考内容
#   deepseek-chat    首字  0.6s / 总 11.3s，无思考内容（非思考模式）
#
# deepseek-flash **默认开思考**，所以明显更慢。本项目已在 app.py 里
# 处理 reasoning_content：思考期间向前端推「模型正在思考…」状态，
# 不会出现"空白泡泡转几十秒"的观感；思考内容本身不会混进正文。
# 若想换回快档，把下面一行改成 deepseek-chat 即可。
DEEPSEEK_MODEL=deepseek-flash

# ── 文献数据源说明 ────────────────────────────────────────
# 项目自带五个数据源，**都不需要付费**：
#
#   Semantic Scholar   英文为主，免费。不配 key 也能用，但走的是所有人共用的
#                      公共通道，高峰期 /paper/search 会持续返回 429/5xx。
#                      配 key 后是自己的独立配额（默认 1 请求/秒），稳定得多。
#                      申请：https://www.semanticscholar.org/product/api#api-key-form
#
#   OpenAlex           英文+中文，完全免费、无需 key，默认启用。
#                      中文靠 filter=language:zh 过滤，是本项目主要的中文来源。
#                      中文核心期刊覆盖率不如知网/万方，不少中文文献没有摘要或 DOI。
#
#   Crossref           正式出版物元数据的权威源。**卷期页码最全**，GB/T 7714
#                      参考文献的"年, 卷(期): 起止页"主要靠它补全。
#                      免费、无需注册，但**必须带 mailto** 进礼貌池（见下）。
#                      不提供被引次数（它给的 is-referenced-by-count 很多出版商
#                      没提交，实测常为 0，所以本项目不拿它当影响力指标）。
#
#   Europe PMC         生命科学/生物医学，免费无需 key。带**被引次数**和摘要，
#                      一次请求就能拿全。注意：它的元数据以英文为主，对中国期刊
#                      给的也多是英文版，所以**不当中文源用**。
#
#   DOAJ               只收录经过审核的开放获取期刊，用来判断"能不能免费读全文"。
#                      免费无需 key。**只有 OA 期刊**，且不提供被引次数。
#
# 中文覆盖的现状（如实说明）：真正的中文核心期刊覆盖仍不如知网/万方。
# 知网不开放个人 API；万方有开放平台（open.wf.pub，接口是
# X-Ca-AppKey + Authorization: APPCODE），但需要商务申请、商业授权。
# 代码里预留了接入位置：新增一个 provider 文件 + 在 providers/__init__.py
# 的 SOURCES 和 GROUPS 各加一行，业务代码不用动。

# ── Semantic Scholar ─────────────────────────────────────
# 强烈建议配置。不配也能用，但公共通道高峰期基本不可用。
SEMANTIC_SCHOLAR_API_KEY=

# 两次请求之间的最小间隔秒数（默认 1.2，比限额略宽一点更安全）
S2_MIN_INTERVAL=1.2
# 单次请求最多尝试次数（默认 4）
S2_MAX_RETRIES=4
# 退避等待上限秒数（默认 20）
S2_BACKOFF_CAP=20
# 检索结果缓存时间秒数（默认 1800，相同检索不再重复打接口）
S2_CACHE_TTL=1800
# 被限流时是否改用 /paper/search/bulk 兜底（1=开启，0=关闭）
S2_BULK_FALLBACK=1

# ── OpenAlex ─────────────────────────────────────────────
# 选填邮箱。带上会进入"礼貌池"，服务更稳定（只作为联系标识，不会公开展示）
OPENALEX_MAILTO=
# 两次请求最小间隔秒数（默认 0.2，OpenAlex 宽松，不用压太狠）
OPENALEX_MIN_INTERVAL=0.2
# 检索结果缓存秒数（默认 1800）
OPENALEX_CACHE_TTL=1800

# ── Crossref ─────────────────────────────────────────────
# **强烈建议填写**。Crossref 的配额按"池"划分，实测响应头：
#   公开池（不带 mailto）：5 次/秒、并发 1  → 并发检索时很容易 429
#   礼貌池（带 mailto）：  10 次/秒、并发 3
# 只作为联系标识，Crossref 明确建议带上（出问题时会先联系你而不是直接封）。
CROSSREF_MAILTO=
# 两次请求最小间隔秒数（默认 0.34 ≈ 3 次/秒，取检索接口的额度）
CROSSREF_MIN_INTERVAL=0.34
# 检索结果缓存秒数（默认 1800）
CROSSREF_CACHE_TTL=1800

# ── Europe PMC ───────────────────────────────────────────
# 两次请求最小间隔秒数（默认 0.4）
EUROPEPMC_MIN_INTERVAL=0.4
# 检索结果缓存秒数（默认 1800）
EUROPEPMC_CACHE_TTL=1800

# ── DOAJ ─────────────────────────────────────────────────
# 两次请求最小间隔秒数（默认 0.5）
DOAJ_MIN_INTERVAL=0.5
# 检索结果缓存秒数（默认 1800）
DOAJ_CACHE_TTL=1800

# ── 网络 ─────────────────────────────────────────────────
# 如果国内访问国外 API 不稳定，可配置代理（按需取消注释）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# API 超时秒数（默认 30 秒）
API_TIMEOUT=30

# ── 会话密钥（必填，缺了会拒绝启动）─────────────────────────
# Flask 的登录态就是一枚用它签名的 cookie。密钥一旦可猜，
# 任何人都能自己签一个"我是 1 号用户"的 cookie 冒充登录，
# 从而读到别人的对话记录和收藏 —— 所以**必须**是随机值，
# 且不能沿用代码里那个公开的示例值。
#
# 生成方式（在项目根目录执行，把输出的那行贴到 .env）：
#   python -c "import secrets; print('FLASK_SECRET_KEY=' + secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ── 公网部署（挂域名 / 内网穿透时看这里）──────────────────
# 监听地址与端口。默认只监听本机 127.0.0.1:8000。
# 内网穿透工具（natapp/ngrok 等）转发的是**隧道里配置的那个本地端口**，
# 隧道若填的是 80，这里就用 APP_PORT=80 启动去对齐：
# APP_HOST=127.0.0.1
# APP_PORT=8000

# 公网访问口令（可选）。留空=完全开放。
# 建议公网部署时设置：本站暴露的是**共享的 DeepSeek 额度**，
# 链接被随手转发后可能被爬虫或陌生人刷掉费用。
# 设了之后所有页面和接口都要先输这个口令才能进。
# PUBLIC_PASSWORD=
